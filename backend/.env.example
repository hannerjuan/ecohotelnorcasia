# Conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecohotel?schema=public"
# Puerto del API
PORT=4000
# Clave secreta para firmar las sesiones (cámbiala en producción)
JWT_SECRET="cambia-esta-clave-secreta"
# Administrador inicial que crea el seed
ADMIN_EMAIL="ecohotelmadeguadua@gmail.com"
ADMIN_PASSWORD="CambiaEstaClave123"
ADMIN_NAME="Administrador"
# Carpeta donde se guardan las imágenes subidas
UPLOAD_DIR="./uploads"
# Origen del frontend permitido (solo si frontend y API están en dominios distintos)
CORS_ORIGIN=""
# true en producción con HTTPS
COOKIE_SECURE=false
